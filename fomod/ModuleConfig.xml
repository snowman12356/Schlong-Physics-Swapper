<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Schlong Physics Swapper 1.8.2</moduleName>
  <requiredInstallFiles>
    <file source="SKSE\Plugins\SchlongPhysicsSwapper.dll" destination="SKSE\Plugins\SchlongPhysicsSwapper.dll" priority="0" />
    <file source="SKSE\Plugins\CBPCMasterConfig_ZZZ_SchlongPhysicsSwapper.txt" destination="SKSE\Plugins\CBPCMasterConfig_ZZZ_SchlongPhysicsSwapper.txt" priority="0" />
    <file source="SKSE\Plugins\CBPConfig_ZZZ_SchlongPhysicsSwapper.txt" destination="SKSE\Plugins\CBPConfig_ZZZ_SchlongPhysicsSwapper.txt" priority="0" />
    <file source="Scripts\SPS_SexLabBridge.pex" destination="Scripts\SPS_SexLabBridge.pex" priority="0" />
    <file source="Source\Scripts\SPS_SexLabBridge.psc" destination="Source\Scripts\SPS_SexLabBridge.psc" priority="0" />
    <folder source="docs" destination="docs" priority="0" />
    <folder source="Licenses" destination="Licenses" priority="0" />
    <file source="README.md" destination="README.md" priority="0" />
    <file source="LICENSE" destination="LICENSE" priority="0" />
    <file source="THIRD_PARTY.md" destination="THIRD_PARTY.md" priority="0" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Arousal mod">
      <optionalFileGroups order="Explicit">
        <group name="Which arousal mod do you use?" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="OSL Aroused">
              <description>Choose this if you use OSL Aroused. SPS will install its player compatibility file.</description>
              <files>
                <file source="Scripts\OSLAroused_Main.pex" destination="Scripts\OSLAroused_Main.pex" priority="10" />
                <folder source="Source\OSL Aroused Compatibility" destination="Source\OSL Aroused Compatibility" priority="0" />
              </files>
              <typeDescriptor><type name="Optional" /></typeDescriptor>
            </plugin>
            <plugin name="SLO Aroused NG">
              <description>Choose this if you use SLO Aroused NG. No extra SPS file is needed. Leave SLO's Use SOS option off.</description>
              <files />
              <typeDescriptor><type name="Optional" /></typeDescriptor>
            </plugin>
            <plugin name="SexLab Aroused Redux">
              <description>Choose this if you use SexLab Aroused Redux. No extra SPS file is needed. Leave Redux's Enable SOS option off.</description>
              <files />
              <typeDescriptor><type name="Optional" /></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
    <installStep name="Settings">
      <optionalFileGroups order="Explicit">
        <group name="Choose a settings option" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="Install recommended settings">
              <description>Best for a new installation. Installs the tested defaults.</description>
              <files>
                <file source="SKSE\Plugins\SchlongPhysicsSwapper.ini" destination="SKSE\Plugins\SchlongPhysicsSwapper.ini" priority="10" />
              </files>
              <typeDescriptor><type name="Recommended" /></typeDescriptor>
            </plugin>
            <plugin name="Keep my existing settings">
              <description>For updates only. Does not replace your existing SchlongPhysicsSwapper.ini.</description>
              <files />
              <typeDescriptor><type name="Optional" /></typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
</config>
